
<%@ Master Language="C#" AutoEventWireup="true"
    CodeBehind="Site.Master.cs"
    Inherits="Stillroom_Frontend.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>
        Stillroom
        <asp:ContentPlaceHolder ID="TitleContent" runat="server" />
    </title>

    <link rel="icon" type="image/png"
        href="<%= ResolveUrl("~/Content/images/logo.png") %>" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />

    <style>
        :root {
            --green: #35594b;
            --green-dark: #243f35;
            --green-light: #e4eadf;
            --cream: #f7f5ef;
            --white: #ffffff;
            --text: #28362f;
            --muted: #788078;
            --border: #e5e2d8;
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            font-family: "Segoe UI", Arial, sans-serif;
            background: var(--cream);
            color: var(--text);
            line-height: 1.6;
        }

        /* NAVIGATION */

        .site-header {
            position: relative;
            z-index: 100;
            background: rgba(255, 255, 255, 0.97);
            border-bottom: 1px solid var(--border);
        }

        .nav-container {
            width: 100%;
            max-width: 1250px;
            margin: 0 auto;
            padding: 14px 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 25px;
        }

        .brand {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            color: var(--green);
            font-family: Georgia, "Times New Roman", serif;
            font-size: 30px;
            font-weight: bold;
            letter-spacing: -1px;
            text-decoration: none;
            white-space: nowrap;
        }

        .brand-logo {
            display: block;
            width: 42px;
            height: 42px;
            object-fit: contain;
        }

        .brand-dot {
            color: #8b9b7b;
        }

        .nav-links {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            flex-wrap: wrap;
            gap: 25px;
        }

        .nav-links a {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            color: var(--text);
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            transition: color 0.2s ease;
        }

        .nav-links a:hover,
        .nav-links a:focus {
            color: #7b9475;
        }

        .nav-icon {
            width: 18px;
            height: 18px;
            object-fit: contain;
        }

        .nav-links .nav-register {
            padding: 11px 20px;
            background: var(--green);
            color: var(--white);
            border-radius: 30px;
            transition: background 0.2s ease;
        }

        .nav-links .nav-register:hover {
            background: var(--green-dark);
            color: var(--white);
        }

        /* PAGE CONTENT */

        .page-container {
            min-height: 70vh;
            padding: 35px 24px 55px;
            background: var(--cream);
        }

        .page-content {
            width: 100%;
            max-width: 1150px;
            margin: 0 auto;
        }

        /* FOOTER */

        .site-footer {
            position: relative;
            overflow: hidden;
            background: var(--green-dark);
            color: #f4f3ec;
            padding: 38px 24px 25px;
            text-align: center;
        }

        .footer-decoration {
            position: absolute;
            left: 20px;
            bottom: -18px;
            width: 105px;
            height: 105px;
            object-fit: contain;
            opacity: 0.18;
            pointer-events: none;
        }

        .footer-brand {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            font-family: Georgia, "Times New Roman", serif;
            font-size: 27px;
            font-weight: bold;
        }

        .footer-logo {
            width: 32px;
            height: 32px;
            object-fit: contain;
            filter: brightness(0) invert(1);
        }

        .footer-tagline {
            margin: 8px 0;
            font-size: 15px;
        }

        .footer-muted {
            color: #c4d0c5;
            font-size: 13px;
        }

        .footer-bottom {
            margin-top: 20px;
            padding-top: 16px;
            border-top: 1px solid rgba(255, 255, 255, 0.13);
            color: #c4d0c5;
            font-size: 12px;
        }

        /* RESPONSIVE LAYOUT */

        @media (max-width: 760px) {
            .nav-container {
                flex-direction: column;
                padding: 16px;
                gap: 15px;
            }

            .nav-links {
                justify-content: center;
                gap: 15px 20px;
            }

            .page-container {
                padding: 25px 16px 40px;
            }

            .footer-decoration {
                width: 65px;
                height: 65px;
            }
        }

        @media (max-width: 420px) {
            .brand {
                font-size: 27px;
            }

            .nav-links {
                gap: 12px;
            }

            .nav-links a {
                font-size: 13px;
            }

            .nav-links .nav-register {
                padding: 9px 14px;
            }
        }
    </style>
</head>

<body>
    <form id="form1" runat="server">

        <!-- HEADER AND NAVIGATION -->
        <header class="site-header">
            <div class="nav-container">

                <asp:HyperLink ID="lnkBrand" runat="server"
                    NavigateUrl="~/Default.aspx"
                    CssClass="brand">

                    <asp:Image ID="imgLogo" runat="server"
                        ImageUrl="~/Content/images/logo.png"
                        AlternateText="Stillroom logo"
                        CssClass="brand-logo" />

                    <span>stillroom<span class="brand-dot">.</span></span>
                </asp:HyperLink>

                <nav class="nav-links" aria-label="Main navigation">

                    <asp:HyperLink ID="lnkHome" runat="server"
                        NavigateUrl="~/Default.aspx">
                        <asp:Image ID="imgHomeIcon" runat="server"
                            ImageUrl="~/Content/images/home-icon.png"
                            AlternateText=""
                            CssClass="nav-icon" />
                        Home
                    </asp:HyperLink>

                    <asp:HyperLink ID="lnkAbout" runat="server"
                        NavigateUrl="~/About.aspx">
                        <asp:Image ID="imgAboutIcon" runat="server"
                            ImageUrl="~/Content/images/about-icon.png"
                            AlternateText=""
                            CssClass="nav-icon" />
                        About
                    </asp:HyperLink>

                    <asp:HyperLink ID="lnkContact" runat="server"
                        NavigateUrl="~/Contact.aspx">
                        <asp:Image ID="imgContactIcon" runat="server"
                            ImageUrl="~/Content/images/contact-icon.png"
                            AlternateText=""
                            CssClass="nav-icon" />
                        Contact
                    </asp:HyperLink>

                    
<asp:HyperLink ID="lnkLogin" runat="server"
    NavigateUrl="~/Login.aspx">
    <asp:Image ID="imgUserIcon" runat="server"
        ImageUrl="~/Content/images/user-icon.png"
        AlternateText=""
        CssClass="nav-icon" />
    Log in
</asp:HyperLink>

<asp:HyperLink ID="lnkRegister" runat="server"
    NavigateUrl="~/Register.aspx"
    CssClass="nav-register">
    Get started
</asp:HyperLink>

<asp:HyperLink ID="lnkDashboard" runat="server"
    NavigateUrl="~/Dashboard.aspx"
    Visible="false">
    Dashboard
</asp:HyperLink>

<asp:HyperLink ID="lnkFocusRoom" runat="server"
    NavigateUrl="~/FocusRoom.aspx"
    Visible="false">
    Focus Room
</asp:HyperLink>

<asp:LinkButton ID="btnLogout" runat="server"
    OnClick="btnLogout_Click"
    Visible="false"
    CausesValidation="false">
    Log out
</asp:LinkButton>

                </nav>
            </div>
        </header>

        <!-- EACH ASPX PAGE DISPLAYS ITS OWN CONTENT HERE -->
        <main class="page-container">
            <div class="page-content">
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </div>
        </main>

        <!-- SHARED FOOTER -->
        <footer class="site-footer">

            <asp:Image ID="imgFooterDecoration" runat="server"
                ImageUrl="~/Content/images/leaf-decoration.png"
                AlternateText=""
                CssClass="footer-decoration" />

            <div class="footer-brand">
                <asp:Image ID="imgFooterLogo" runat="server"
                    ImageUrl="~/Content/images/logo.png"
                    AlternateText=""
                    CssClass="footer-logo" />
                stillroom.
            </div>

            <p class="footer-tagline">
                Make space for what matters.
            </p>

            <p class="footer-muted">
                A calmer place to study, focus, and grow.
            </p>

            <div class="footer-bottom">
                &copy; <%: DateTime.Now.Year %> Stillroom. All rights reserved.
            </div>

        </footer>

    </form>
</body>
</html>
