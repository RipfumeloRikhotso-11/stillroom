<?xml version="1.0" encoding="utf-8"?><Database Name="StillroomDB" Class="StillroomDataContext" xmlns="http://schemas.microsoft.com/linqtosql/dbml/2007">
  <Table Name="dbo.USERS" Member="USERs">
    <Type Name="USER">
      <Column Name="UserID" Type="System.Int32" DbType="Int NOT NULL IDENTITY" IsPrimaryKey="true" IsDbGenerated="true" CanBeNull="false" />
      <Column Name="FullName" Type="System.String" DbType="VarChar(100) NOT NULL" CanBeNull="false" />
      <Column Name="Email" Type="System.String" DbType="VarChar(255) NOT NULL" CanBeNull="false" />
      <Column Name="PasswordHash" Type="System.String" DbType="VarChar(500) NOT NULL" CanBeNull="false" />
      <Column Name="CreatedAt" Type="System.DateTime" DbType="DateTime2 NOT NULL" CanBeNull="false" />
      <Column Name="IsActive" Type="System.Boolean" DbType="Bit NOT NULL" CanBeNull="false" />
      <Association Name="USER_FOCUS_SESSION" Member="FOCUS_SESSIONs" ThisKey="UserID" OtherKey="UserID" Type="FOCUS_SESSION" />
      <Association Name="USER_APP_SETTING" Member="APP_SETTINGs" ThisKey="UserID" OtherKey="UserID" Type="APP_SETTING" />
    </Type>
  </Table>
  <Table Name="dbo.SESSION_TASK" Member="SESSION_TASKs">
    <Type Name="SESSION_TASK">
      <Column Name="TaskID" Type="System.Int32" DbType="Int NOT NULL IDENTITY" IsPrimaryKey="true" IsDbGenerated="true" CanBeNull="false" />
      <Column Name="SessionID" Type="System.Int32" DbType="Int NOT NULL" CanBeNull="false" />
      <Column Name="TaskDescription" Type="System.String" DbType="VarChar(200) NOT NULL" CanBeNull="false" />
      <Column Name="IsComplete" Type="System.Boolean" DbType="Bit NOT NULL" CanBeNull="false" />
      <Column Name="TaskPosition" Type="System.Int32" DbType="Int NOT NULL" CanBeNull="false" />
      <Association Name="FOCUS_SESSION_SESSION_TASK" Member="FOCUS_SESSION" ThisKey="SessionID" OtherKey="SessionID" Type="FOCUS_SESSION" IsForeignKey="true" DeleteRule="CASCADE" DeleteOnNull="true" />
    </Type>
  </Table>
  <Table Name="dbo.FOCUS_SESSION" Member="FOCUS_SESSIONs">
    <Type Name="FOCUS_SESSION">
      <Column Name="SessionID" Type="System.Int32" DbType="Int NOT NULL IDENTITY" IsPrimaryKey="true" IsDbGenerated="true" CanBeNull="false" />
      <Column Name="UserID" Type="System.Int32" DbType="Int NOT NULL" CanBeNull="false" />
      <Column Name="SessionGoal" Type="System.String" DbType="VarChar(200) NOT NULL" CanBeNull="false" />
      <Column Name="DurationMinutes" Type="System.Int32" DbType="Int NOT NULL" CanBeNull="false" />
      <Column Name="StartedAt" Type="System.DateTime" DbType="DateTime2 NOT NULL" CanBeNull="false" />
      <Column Name="CompletedAt" Type="System.DateTime" DbType="DateTime2" CanBeNull="true" />
      <Association Name="FOCUS_SESSION_SESSION_TASK" Member="SESSION_TASKs" ThisKey="SessionID" OtherKey="SessionID" Type="SESSION_TASK" />
      <Association Name="USER_FOCUS_SESSION" Member="USER" ThisKey="UserID" OtherKey="UserID" Type="USER" IsForeignKey="true" />
    </Type>
  </Table>
  <Table Name="dbo.APP_SETTINGS" Member="APP_SETTINGs">
    <Type Name="APP_SETTING">
      <Column Name="SettingsID" Type="System.Int32" DbType="Int NOT NULL IDENTITY" IsPrimaryKey="true" IsDbGenerated="true" CanBeNull="false" />
      <Column Name="UserID" Type="System.Int32" DbType="Int NOT NULL" CanBeNull="false" />
      <Column Name="TimerMinutes" Type="System.Int32" DbType="Int NOT NULL" CanBeNull="false" />
      <Column Name="AmbientSound" Type="System.String" DbType="VarChar(20) NOT NULL" CanBeNull="false" />
      <Column Name="Volume" Type="System.Int32" DbType="Int NOT NULL" CanBeNull="false" />
      <Association Name="USER_APP_SETTING" Member="USER" ThisKey="UserID" OtherKey="UserID" Type="USER" IsForeignKey="true" DeleteRule="CASCADE" DeleteOnNull="true" />
    </Type>
  </Table>
  <Table Name="dbo.ContactMessage" Member="ContactMessages">
    <Type Name="ContactMessage">
      <Column Name="MessageID" Type="System.Int32" DbType="Int NOT NULL IDENTITY" IsPrimaryKey="true" IsDbGenerated="true" CanBeNull="false" />
      <Column Name="FullName" Type="System.String" DbType="NVarChar(100) NOT NULL" CanBeNull="false" />
      <Column Name="Email" Type="System.String" DbType="NVarChar(254) NOT NULL" CanBeNull="false" />
      <Column Name="Subject" Type="System.String" DbType="NVarChar(150) NOT NULL" CanBeNull="false" />
      <Column Name="MessageText" Type="System.String" DbType="NVarChar(2000) NOT NULL" CanBeNull="false" />
      <Column Name="SubmittedAt" Type="System.DateTime" DbType="DateTime NOT NULL" CanBeNull="false" />
    </Type>
  </Table>
</Database>